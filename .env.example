# ==========================================
# CONSEJO ECONÓMICO DE IA - CONFIGURACIÓN
# ==========================================
# Copia este archivo a .env y añade tu clave real:
# cp .env.example .env

# Clave de API de GroqCloud (REQUERIDO)
GROQ_API_KEY=gsk_your_groq_api_key_here_template

# Modelos configurados en Groq
DEBATER_MODEL=openai/gpt-oss-120b
ARBITER_MODEL=openai/gpt-oss-120b
FAST_MODEL=openai/gpt-oss-20b
SECOND_OPINION_MODEL=qwen/qwen3.8-27b

# Parámetros de Inferencia
DEBATER_CAPITALIST_TEMP=0.65
DEBATER_COLLECTIVIST_TEMP=0.65
DEBATER_SOCDEM_TEMP=0.60
ARBITER_TEMP=0.10
REASONING_EFFORT=medium

# Límites de Tokens y Rate Limit
MAX_TOKENS_DEBATER=1024
MAX_TOKENS_ARBITER=2048
RATE_LIMIT_RPM=60
MAX_RETRIES=5

# Modo de Ejecución: live, record, replay
EXECUTION_MODE=record
CACHE_DB_PATH=outputs/llm_cache.sqlite
